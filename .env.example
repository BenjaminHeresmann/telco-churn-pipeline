# =============================================================
# Configuracion para SUPABASE (Postgres como servicio)
# Obtener desde: Supabase Dashboard > Settings > Database
# =============================================================

# Connection string completo (recomendado - incluye SSL)
# Formato: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxx:tu_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Alternativa: variables individuales (usadas si DATABASE_URL no esta seteado)
POSTGRES_HOST=aws-0-us-east-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=postgres.xxxxx
POSTGRES_PASSWORD=tu_password
POSTGRES_SSLMODE=require

# =============================================================
# Configuracion para Supabase Storage (opcional, para CSVs)
# Obtener desde: Supabase Dashboard > Settings > API
# =============================================================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGc... (anon o service_role key)
SUPABASE_BUCKET=telco-data

# Si se prefiere ingestar desde archivo local (modo dev), comentar SUPABASE_URL
# y descomentar:
# SOURCE_CSV_PATH=./data/source/telco_churn.csv

# Nombre del archivo dentro del bucket de Supabase Storage
SOURCE_CSV_FILENAME=telco_churn_source.csv

# =============================================================
# Configuracion general
# =============================================================
LOG_LEVEL=INFO

# Puerto donde corre la API (Railway lo setea automaticamente como $PORT)
PORT=8000

# Origen permitido para CORS si se conecta un frontend
CORS_ORIGINS=http://localhost:3000,https://tu-frontend.vercel.app
