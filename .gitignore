# Entornos virtuales
venv/
.venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# Variables de entorno (credenciales)
.env
.env.local

# Datos del pipeline (no se versionan, solo el dataset fuente)
data/raw/*
data/clean/*
data/validated/*
data/rejected/*
!data/raw/.gitkeep
!data/clean/.gitkeep
!data/validated/.gitkeep
!data/rejected/.gitkeep

# Logs
logs/*.log
logs/*.txt
!logs/.gitkeep

# IDEs
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Notebooks de exploracion
*.ipynb_checkpoints/

